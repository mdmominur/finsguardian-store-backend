NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@localhost:5432/gadget_shop
JWT_ACCESS_SECRET=change-me-min-32-chars-access-secret-key
JWT_REFRESH_SECRET=change-me-min-32-chars-refresh-secret-key
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_DAYS=7
# Comma-separated allowed origins in production. In development the API reflects the request origin (LAN-friendly).
CORS_ORIGIN=http://localhost:3000

# Public URL of the Next.js app (used in invoice emails). Falls back to CORS_ORIGIN if empty.
PUBLIC_APP_URL=http://localhost:3000

# SMTP (invoice emails). Leave MAIL_HOST empty to disable sending.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=TechTubeBD

# Shop signup email OTP (defaults shown).
REGISTRATION_OTP_TTL_MIN=10
REGISTRATION_OTP_MAX_ATTEMPTS=5

# Internal dashboard (OTP email login). Required in production (min 32 chars). In development you may omit — a value is derived from JWT_ACCESS_SECRET.
INTERNAL_JWT_ACCESS_SECRET=change-me-min-32-chars-internal-dashboard-only
INTERNAL_JWT_ACCESS_EXPIRES_MIN=480
INTERNAL_OTP_TTL_MIN=10
INTERNAL_OTP_MAX_ATTEMPTS=5
